# Optional: the public preview runs in demo mode without an API key.
# Keep this key server-side. Never expose it with a NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default when the participant entry screen does not send a model selection.
# Allowed values: deepseek-v4-flash | deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# Local result storage (one-machine development and rehearsal only).
RMW_LOCAL_RESULTS_DIR=.rmw-results

# Required in both local and deployed environments.
PARTICIPANT_SESSION_SECRET=replace-with-a-long-random-secret
RESEARCHER_ADMIN_PASSWORD=replace-with-a-strong-researcher-password
RESEARCHER_SESSION_SECRET=replace-with-a-different-long-random-secret

# Production result storage. Apply the migration in supabase/migrations first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
